# 复制为 .env 后按需修改
# 注意：本文件必须放在 backend/ 下（与 app/ 同级），因为加载时按进程工作目录找 .env
# 优先级：系统环境变量 > backend/.env > app/core/config.py 里的默认值

# ---------------------------------------------------------------------------
# PostgreSQL 连接串
# 格式：postgresql+psycopg://用户名:密码@主机:端口/数据库名
#   postgresql  数据库类型
#   +psycopg    驱动，必须是 psycopg（v3）；漏写会退回 psycopg2，而项目没装它
# 密码里若含 @ : / ? # 等字符，需要做 URL 编码（例如 @ → %40）
# ---------------------------------------------------------------------------
MBTI_DATABASE_URL=postgresql+psycopg://mbti:mbti@localhost:5432/mbti

# 连接超时与建表超时（秒）：数据库没起时快速失败，不让服务卡在 startup
MBTI_DB_CONNECT_TIMEOUT=3
MBTI_DB_INIT_TIMEOUT_SECONDS=8

# ---------------------------------------------------------------------------
# 业务参数
# ---------------------------------------------------------------------------
# 会话有效期（分钟）
MBTI_SESSION_TTL_MINUTES=120

# 每维度抽题数
MBTI_PER_DIM=10

# 每 IP 每小时可创建的会话数
MBTI_RATE_LIMIT_PER_HOUR=20

# 开发期前端地址（逗号分隔）；生产走同域反代，留空
MBTI_CORS_ORIGINS=http://localhost:3000
